{
	"name": "bom-api",
	"version": "2.0.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:live": "BOM_LIVE=1 vitest run live"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-bom-api.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.2.1",
		"axios": "^1.20.0",
		"lodash": "~4.18.1",
		"p-queue": "^9.3.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/lodash": "4.17.25",
		"@types/node": "^26.6.4",
		"@vitest/coverage-v8": "5.0.3",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"vitest": "5.0.3"
	},
	"engines": {
		"node": "^26.10"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
